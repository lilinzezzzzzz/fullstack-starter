# Python 字节码与打包产物
__pycache__/
*.py[cod]
*$py.class
.Python
build/
dist/
.eggs/
*.egg-info/
*.egg

# 虚拟环境与本机环境变量
.venv/
venv/
env/
ENV/
__pypackages__/
.env*
!.env.example
!.env.sample
!.env.template
!.env.*.example

# 测试、覆盖率和分析缓存
.pytest_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.ruff_cache/
.mypy_cache/
.pyre/
.pytype/
.ipynb_checkpoints/

# PyCharm 本机工作区、任务与历史记录
.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/dictionaries/
.idea/shelf/
.idea/httpRequests/
http-client.private.env.json
.idea/dataSources/
.idea/dataSources.local.xml
# 项目约定所有 PyCharm 设置都只在本机使用时，可启用下面的规则。
# .idea/

# VS Code workspace 中可共享的配置
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# 系统元数据
.DS_Store
Thumbs.db

# 项目专用规则
.secrets*
.data/
.run/
# 默认目录更名后，继续忽略旧版的本地数据目录。
data/
logs/
*.pid
*.pid.lock
*.service.json
*.service.json.pending
*.service.lock
*.service.instance.lock
*.log
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3.lock
configs/*.local.toml
# 继续忽略已弃用的本地私有配置文件，但不再加载它们。
configs/*.local.json
frontend/node_modules/
frontend/.pnpm-store/
frontend/test-results/
frontend/playwright-report/
